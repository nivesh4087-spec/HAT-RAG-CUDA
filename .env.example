# Copy to .env and fill in. .env is git-ignored.
# Groq (default provider): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: pin a model, otherwise the best one your account offers is picked
# GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (fallback when Groq is missing or rate-limited): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
